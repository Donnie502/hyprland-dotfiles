(include "dashboard.yuck")
(deflisten cava-values :initial "[]" "$HOME/.config/eww/scripts/cava.sh")

(defwidget barras [align]
  (box :class "cava" :space-evenly true :spacing 1
    (for value in cava-values
      (box :valign align :halign "center"
        (box :class "bar" :halign "center" :style "min-height: ${value}px;")))))

(defwindow bars-top
  :monitor 0
  :geometry (geometry :x "0%" :y "-42px" :width "100%" :height "180px" :anchor "top center")
  :stacking "bg" :focusable false :exclusive false
  (barras :align "start"))

(defwindow bars-bottom
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "180px" :anchor "bottom center")
  :stacking "bg" :focusable false :exclusive false
  (barras :align "end"))
